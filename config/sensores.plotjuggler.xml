<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="Estimacao XY" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="1" count="1">
     <DockArea name="XY: referencia / groundtruth / bruto / EKF">
      <plot mode="XYPlot" style="Lines" flip_x="false" flip_y="false">
       <range left="-1.6" right="1.6" top="1.6" bottom="-1.6"/>
       <limitY/>
       <curve name="referencia" color="#2ca02c" curve_x="/trajectory_eight/reference/point/x" curve_y="/trajectory_eight/reference/point/y"/>
       <curve name="groundtruth" color="#1f77b4" curve_x="/state/groundtruth/point/x" curve_y="/state/groundtruth/point/y"/>
       <curve name="sensores_brutos" color="#bcbd22" curve_x="/state/raw/point/x" curve_y="/state/raw/point/y"/>
       <curve name="ekf" color="#ff7f0e" curve_x="/state/filtered/point/x" curve_y="/state/filtered/point/y"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Estados x y yaw" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.34;0.33;0.33" count="3">
     <DockArea name="x [m]">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="40" top="1.6" bottom="-1.6"/>
       <limitY/>
       <curve name="/trajectory_eight/reference/point/x" color="#2ca02c"/>
       <curve name="/state/groundtruth/point/x" color="#1f77b4"/>
       <curve name="/state/raw/point/x" color="#bcbd22"/>
       <curve name="/state/filtered/point/x" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="y [m]">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="40" top="1.6" bottom="-1.6"/>
       <limitY/>
       <curve name="/trajectory_eight/reference/point/y" color="#2ca02c"/>
       <curve name="/state/groundtruth/point/y" color="#1f77b4"/>
       <curve name="/state/raw/point/y" color="#bcbd22"/>
       <curve name="/state/filtered/point/y" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="yaw [rad]">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="40" top="3.5" bottom="-3.5"/>
       <limitY/>
       <curve name="/state/groundtruth/point/z" color="#1f77b4"/>
       <curve name="/state/raw/point/z" color="#bcbd22"/>
       <curve name="/state/filtered/point/z" color="#ff7f0e"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Erro e controle" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.5;0.5" count="2">
     <DockArea name="Erro de seguimento |e| [m]">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="40" top="1" bottom="0"/>
       <limitY/>
       <curve name="/trajectory_eight/error/vector/z" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="Sinais de controle (cmd_vel)">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="40" top="3" bottom="-3"/>
       <limitY/>
       <curve name="/cmd_vel/linear/x" color="#1f77b4"/>
       <curve name="/cmd_vel/angular/z" color="#ff7f0e"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="IMU / GPS" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.25;0.25;0.25;0.25" count="4">
     <DockArea name="IMU - velocidade angular">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="20" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/imu/data/angular_velocity/x" color="#1f77b4"/>
       <curve name="/imu/data/angular_velocity/y" color="#2ca02c"/>
       <curve name="/imu/data/angular_velocity/z" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="IMU - aceleracao linear">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="20" top="12" bottom="-2"/>
       <limitY/>
       <curve name="/imu/data/linear_acceleration/x" color="#1f77b4"/>
       <curve name="/imu/data/linear_acceleration/y" color="#2ca02c"/>
       <curve name="/imu/data/linear_acceleration/z" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="GPS - latitude">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="20" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/gps/data/latitude" color="#9467bd"/>
      </plot>
     </DockArea>
     <DockArea name="GPS - longitude">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range left="0" right="20" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/gps/data/longitude" color="#ff7f0e"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <!-- - - - - - - - - - - - - - - -->
 <!-- - - - - - - - - - - - - - - -->
 <Plugins>
  <plugin ID="DataLoad CSV"/>
  <plugin ID="DataLoad MCAP"/>
  <plugin ID="DataLoad ROS2 bags"/>
  <plugin ID="DataLoad ULog"/>
  <plugin ID="ROS2 Topic Subscriber">
   <selected_topics>
    <topic name="/imu/data"/>
    <topic name="/gps/data"/>
    <topic name="/odom"/>
    <topic name="/odometry/filtered"/>
    <topic name="/odometry/gps"/>
    <topic name="/ground_truth"/>
    <topic name="/cmd_vel"/>
    <topic name="/state/raw"/>
    <topic name="/state/filtered"/>
    <topic name="/state/groundtruth"/>
    <topic name="/trajectory_eight/reference"/>
    <topic name="/trajectory_eight/estimate"/>
    <topic name="/trajectory_eight/gps_xy_raw"/>
    <topic name="/trajectory_eight/groundtruth"/>
    <topic name="/trajectory_eight/error"/>
   </selected_topics>
   <boolean_strings_to_number value="false"/>
   <discard_large_arrays value="true"/>
   <max_array_size value="100"/>
   <remove_suffix_from_strings value="true"/>
   <use_header_stamp value="false"/>
  </plugin>
  <plugin ID="UDP Server"/>
  <plugin ID="WebSocket Server"/>
  <plugin ID="ZMQ Subscriber"/>
  <plugin ID="ROS2 Topic Re-Publisher"/>
 </Plugins>
 <!-- - - - - - - - - - - - - - - -->
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
 <!-- - - - - - - - - - - - - - - -->
 <customMathEquations/>
 <snippets/>
 <!-- - - - - - - - - - - - - - - -->
</root>
