<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="slam">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-7.1375</latitude_deg>
      <longitude_deg>-34.8450</longitude_deg>
      <elevation>40.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Sala retangular com corredor e cantos distintos (cenario simples SLAM) -->
    <!-- Parede norte -->
    <model name="wall_n">
      <static>true</static>
      <pose>0 5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.0 0.2 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.0 0.2 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <!-- Parede sul -->
    <model name="wall_s">
      <static>true</static>
      <pose>0 -5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.0 0.2 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.0 0.2 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <!-- Parede leste -->
    <model name="wall_e">
      <static>true</static>
      <pose>5.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.0 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <!-- Parede oeste -->
    <model name="wall_w">
      <static>true</static>
      <pose>-5.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.0 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- Divisor interno (forma L) para loop closure -->
    <model name="divider_1">
      <static>true</static>
      <pose>0 1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.0 0.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.0 0.2 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>
    <model name="divider_2">
      <static>true</static>
      <pose>2.0 -1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 3.0 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 3.0 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- Marcos geometricos distintos -->
    <model name="pillar_red">
      <static>true</static>
      <pose>-3.0 3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>
    <model name="box_blue">
      <static>true</static>
      <pose>3.5 3.5 0.4 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.6 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>
    <model name="box_green">
      <static>true</static>
      <pose>-3.5 -3.0 0.35 0 0 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.5 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.5 0.7</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>
    <model name="cyl_yellow">
      <static>true</static>
      <pose>3.0 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
      </link>
    </model>

  </world>
</sdf>
